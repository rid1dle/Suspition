{
  "name": "detective",
  "version": "0.1.0",
  "description": "A hidden-role mystery game for one room. Phones are character cards, Claude is the game master.",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "node scripts/build-if-needed.ts && node server/index.ts",
    "fresh": "node scripts/build-if-needed.ts && node server/index.ts --new",
    "simplify": "node scripts/simplify-game.ts",
    "rework": "node scripts/rework-cast.ts",
    "fix-cards": "node scripts/fix-cards.ts",
    "dataset": "node scripts/export-dataset.ts",
    "test": "node --test test/*.test.js test/*.test.ts",
    "playtest": "node scripts/playtest.ts",
    "seed-bots": "node scripts/playtest/seed.ts",
    "attacks": "node scripts/attacks.ts",
    "build": "next build",
    "dev": "node server/index.ts --dev"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
