{
  "name": "detective",
  "version": "0.1.0",
  "description": "A hidden-role mystery game for one room. Phones are character cards, Claude is the game master.",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "node scripts/check-node.cjs && node scripts/build-if-needed.ts && node server/index.ts",
    "fresh": "node scripts/check-node.cjs && node scripts/build-if-needed.ts && node server/index.ts --new",
    "simplify": "node scripts/check-node.cjs && node scripts/simplify-game.ts",
    "rework": "node scripts/check-node.cjs && node scripts/rework-cast.ts",
    "fix-cards": "node scripts/check-node.cjs && node scripts/fix-cards.ts",
    "dataset": "node scripts/check-node.cjs && node scripts/export-dataset.ts",
    "test": "node scripts/check-node.cjs && TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test \"test/*.test.{js,ts,tsx}\"",
    "playtest": "node scripts/check-node.cjs && node scripts/playtest.ts",
    "seed-bots": "node scripts/check-node.cjs && node scripts/playtest/seed.ts",
    "attacks": "node scripts/check-node.cjs && node scripts/attacks.ts",
    "build": "next build",
    "dev": "node scripts/check-node.cjs && node server/index.ts --dev",
    "art-samples": "node scripts/check-node.cjs && node scripts/art-samples.ts",
    "samples": "node scripts/check-node.cjs && node scripts/build-samples.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@formkit/auto-animate": "^0.10.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.0.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tone": "15.1.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "ffmpeg-static": "5.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
