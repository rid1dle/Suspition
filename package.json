{
  "name": "detective",
  "version": "0.1.0",
  "description": "A hidden-role mystery game for one room. Phones are character cards, Claude is the game master.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "fresh": "node server/index.js --new",
    "simplify": "node scripts/simplify-game.js",
    "rework": "node scripts/rework-cast.js",
    "fix-cards": "node scripts/fix-cards.js",
    "dataset": "node scripts/export-dataset.js",
    "test": "node --test test/*.test.js",
    "playtest": "node scripts/playtest.js",
    "seed-bots": "node scripts/playtest/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
